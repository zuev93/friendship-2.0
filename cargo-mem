#!/bin/bash
# Cargo extension for building with memory report
# Usage: cargo mem [debug|release]

set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'
BOLD='\033[1m'

echo -e "${BOLD}Building Druzhba firmware...${NC}"
echo ""

MODE="${1:-release}"

if [ "$MODE" = "debug" ]; then
    echo -e "${BLUE}Build mode: DEBUG${NC}"
    echo "Building main-controller..."
    cargo build -p druzhba-main-controller || exit 1
    echo "Building front-panel-controller..."
    cargo build -p druzhba-front-panel-controller || exit 1
    BUILD_DIR="target/thumbv8m.main-none-eabihf/debug"
else
    echo -e "${BLUE}Build mode: RELEASE${NC}"
    echo "Building main-controller..."
    cargo build --release -p druzhba-main-controller || exit 1
    echo "Building front-panel-controller..."
    cargo build --release -p druzhba-front-panel-controller || exit 1
    BUILD_DIR="target/thumbv8m.main-none-eabihf/release"
fi

echo ""

draw_bar() {
    local percent=$1
    local width=40
    local filled=$((percent * width / 100))
    local empty=$((width - filled))

    printf "["
    printf "%${filled}s" | tr ' ' '='
    printf "%${empty}s" | tr ' ' '.'
    printf "]"
}

format_size() {
    local size=$1
    if [ $size -ge 1048576 ]; then
        echo "$(awk -v s="$size" 'BEGIN {printf "%.1f", s / 1048576}') MB"
    elif [ $size -ge 1024 ]; then
        echo "$(awk -v s="$size" 'BEGIN {printf "%.1f", s / 1024}') KB"
    else
        echo "$size B"
    fi
}

color_by_percent() {
    local percent=$1
    if [ $percent -lt 50 ]; then
        echo "$GREEN"
    elif [ $percent -lt 75 ]; then
        echo "$YELLOW"
    else
        echo "$RED"
    fi
}

analyze_binary() {
    local BINARY_NAME=$1
    local FLASH_SIZE=$2
    local RAM_SIZE=$3
    local TITLE=$4
    local PACKAGE_DIR=$5

    echo -e "${BOLD}Analyzing ${TITLE}...${NC}"
    echo ""

    if [ "$MODE" = "debug" ]; then
        SIZE_OUTPUT=$(cd "$PACKAGE_DIR" && cargo size --bin "$BINARY_NAME" -- -A 2>&1)
    else
        SIZE_OUTPUT=$(cd "$PACKAGE_DIR" && cargo size --release --bin "$BINARY_NAME" -- -A 2>&1)
    fi

    TEXT_SIZE=$(echo "$SIZE_OUTPUT" | grep "^\.text" | awk '{print $2}')
    RODATA_SIZE=$(echo "$SIZE_OUTPUT" | grep "^\.rodata" | awk '{print $2}')
    DATA_SIZE=$(echo "$SIZE_OUTPUT" | grep "^\.data" | awk '{print $2}')
    BSS_SIZE=$(echo "$SIZE_OUTPUT" | grep "^\.bss" | awk '{print $2}')
    VECTOR_SIZE=$(echo "$SIZE_OUTPUT" | grep "^\.vector_table" | awk '{print $2}')

    TEXT_SIZE=${TEXT_SIZE:-0}
    RODATA_SIZE=${RODATA_SIZE:-0}
    DATA_SIZE=${DATA_SIZE:-0}
    BSS_SIZE=${BSS_SIZE:-0}
    VECTOR_SIZE=${VECTOR_SIZE:-0}

    FLASH_USED=$((TEXT_SIZE + RODATA_SIZE + DATA_SIZE + VECTOR_SIZE))
    RAM_STATIC=$((DATA_SIZE + BSS_SIZE))

    FLASH_PERCENT=$((FLASH_USED * 100 / FLASH_SIZE))
    RAM_PERCENT=$((RAM_STATIC * 100 / RAM_SIZE))

    echo -e "${BOLD}  FLASH (${FLASH_SIZE} bytes total)${NC}"
    echo "  ---------------------------------------------------------------"
    printf "  %-20s %10s\n" "Vector table:" "$(format_size $VECTOR_SIZE)"
    printf "  %-20s %10s\n" "Code (.text):" "$(format_size $TEXT_SIZE)"
    printf "  %-20s %10s\n" "Constants (.rodata):" "$(format_size $RODATA_SIZE)"
    printf "  %-20s %10s\n" "Init data (.data):" "$(format_size $DATA_SIZE)"
    echo "  ---------------------------------------------------------------"
    FLASH_COLOR=$(color_by_percent $FLASH_PERCENT)
    printf "  ${BOLD}Used:${NC} ${FLASH_COLOR}$(format_size $FLASH_USED)${NC} / $(format_size $FLASH_SIZE) "
    echo -e "${FLASH_COLOR}(${FLASH_PERCENT}%)${NC}"
    echo -n "  "
    draw_bar $FLASH_PERCENT
    echo ""

    echo ""
    echo -e "${BOLD}  RAM - static only (${RAM_SIZE} bytes total)${NC}"
    echo "  ---------------------------------------------------------------"
    printf "  %-20s %10s\n" "Initialized (.data):" "$(format_size $DATA_SIZE)"
    printf "  %-20s %10s\n" "Zeroed (.bss):" "$(format_size $BSS_SIZE)"
    echo "  ---------------------------------------------------------------"
    RAM_COLOR=$(color_by_percent $RAM_PERCENT)
    printf "  ${BOLD}Static:${NC} ${RAM_COLOR}$(format_size $RAM_STATIC)${NC} / $(format_size $RAM_SIZE) "
    echo -e "${RAM_COLOR}(${RAM_PERCENT}%)${NC}"
    echo -n "  "
    draw_bar $RAM_PERCENT
    echo ""
    echo -e "  ${YELLOW}Note: stack usage not included (grows at runtime)${NC}"

    echo ""

    if [ $FLASH_PERCENT -gt 90 ]; then
        echo -e "  ${RED}WARNING: Flash usage above 90%${NC}"
    fi

    if [ $RAM_PERCENT -gt 80 ]; then
        echo -e "  ${RED}WARNING: Static RAM usage above 80%${NC}"
    fi

    echo ""
}

# Both controllers: STM32H563VI — 2 MB Flash, 640 KB SRAM
FLASH_2MB=2097152
SRAM_640KB=655360

analyze_binary "druzhba-main-controller" $FLASH_2MB $SRAM_640KB "Main Controller (STM32H563VI)" "main-controller"
analyze_binary "druzhba-front-panel-controller" $FLASH_2MB $SRAM_640KB "Front Panel Controller (STM32H563VI)" "front-panel-controller"

echo -e "${BOLD}Build completed.${NC}"
